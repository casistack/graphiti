# syntax=docker/dockerfile:1.9
# Custom Dockerfile optimized for Coolify deployment
FROM python:3.12-slim as builder

WORKDIR /app

# Install system dependencies for building (including netcat for health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    ca-certificates \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install uv using the installer script
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin:$PATH"

# Configure uv for optimal Docker usage - disable bytecode compilation for faster builds
ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Copy and build main graphiti-core project
COPY ./pyproject.toml ./README.md ./
COPY ./graphiti_core ./graphiti_core

# Build graphiti-core wheel
RUN --mount=type=cache,target=/root/.cache/uv \
    uv build

# Install the built wheel to make it available for server - disable bytecode compilation
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_COMPILE_BYTECODE=0 pip install dist/*.whl

# Runtime stage - build the server here
FROM python:3.12-slim

# Install system dependencies including netcat for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install uv using the installer script and make it globally available
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin:$PATH"

# Make uv available system-wide for all users
RUN cp /root/.local/bin/uv /usr/local/bin/uv

# Configure uv for runtime - disable bytecode compilation
ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Create non-root user early
RUN groupadd -r app && useradd -r -d /app -g app app

# Copy graphiti-core wheel from builder and set ownership
COPY --from=builder --chown=app:app /app/dist/*.whl /tmp/

# Install graphiti-core wheel first - disable bytecode compilation to avoid timeout
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_COMPILE_BYTECODE=0 uv pip install --system /tmp/*.whl

# Set up the server application with proper ownership from the start
WORKDIR /app
COPY --chown=app:app ./server/pyproject.toml ./server/README.md ./server/uv.lock ./
COPY --chown=app:app ./server/graph_service ./graph_service

# Install server dependencies and application as root first, then change ownership
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_COMPILE_BYTECODE=0 uv sync --frozen --no-dev

# Change ownership of the virtual environment to app user
RUN chown -R app:app /app/.venv

# Switch to app user for runtime
USER app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:/usr/local/bin:$PATH"

# Set port
ENV PORT=8000
EXPOSE $PORT

# Use uv run for execution
CMD ["uv", "run", "uvicorn", "graph_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
