# syntax=docker/dockerfile:1.9
# Custom MCP Dockerfile optimized for Coolify deployment
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies including netcat for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install uv using the installer script
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Add uv to PATH
ENV PATH="/root/.local/bin:${PATH}"

# Configure uv for optimal Docker usage - disable bytecode compilation
# UV_PYTHON forces uv to use the container's Python, ignoring .python-version
ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3 \
    MCP_SERVER_HOST="0.0.0.0" \
    PYTHONUNBUFFERED=1

# Copy the graphiti-core source (root project)
# We place it in /app so that it matches the "../" path expected by mcp_server's pyproject.toml (which will be in /app/mcp_server)
# Must include README.md as pyproject.toml references it
COPY pyproject.toml README.md /app/
COPY graphiti_core /app/graphiti_core

# Copy mcp_server files to a subdirectory
COPY mcp_server /app/mcp_server

# Set working directory to the server
WORKDIR /app/mcp_server

# Install dependencies
# Because we set up the directory structure correctly, uv sync will find graphiti-core at "../" (which is /app)
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_COMPILE_BYTECODE=0 uv sync --no-dev

# Expose port
EXPOSE 8000

# Command to run the new entry point
# Note: entrypoint is overridden by docker-compose, but this is the default
CMD ["uv", "run", "main.py"]
